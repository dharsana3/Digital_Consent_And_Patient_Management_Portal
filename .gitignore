/storage/
/uploads/
*.code-workspace

# Keep placeholder files only if you need empty folders in Git.
# If you need to track backend/storage/uploads/.gitkeep,
# remove the backend/storage/ rule above and use these rules instead:
# !backend/storage/
# !backend/storage/uploads/
# !backend/storage/uploads/.gitkeep

