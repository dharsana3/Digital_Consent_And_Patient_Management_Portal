# ========================================================
# Digital Consent & Patient Document Management Portal
# Environment Configuration Template (Placeholders only)
# ========================================================

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hospital_consent_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security
# Must be at least 256 bits (32+ characters)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Private Document Storage
STORAGE_LOCAL_DIRECTORY=./backend/storage/uploads
STORAGE_MAX_FILE_SIZE_MB=10

# AI Assistant Configuration
# Options for AI_PROVIDER_TYPE: GLOSSARY (offline default, no key needed), GEMINI, OPENAI, GROQ
AI_PROVIDER_TYPE=GLOSSARY
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash
AI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
